# ── CONTOH ENV (SALIN JADI `.env.local`) ────────────────────────────────────
# File ini SENGAJA hanya berisi nama variabel + nilai contoh. `.env.local`
# gitignored, jadi kunci lokal tidak pernah ikut ter-commit.

# Web Push (VAPID) — digenerate lokal via Node crypto (P-256).
# Public key dibagikan ke client; private key HANYA di server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@catetind.example

# ── Supabase (paket 45) ──────────────────────────────────────────────────────
# Kunci "publishable"/anon boleh ada di klien: yang melindungi data adalah RLS
# di database (`user_id = auth.uid()`), bukan kerahasiaan kunci ini.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sb_publishable_...>

# DILARANG menaruh kunci rahasia peran server di sini, di repo, atau di variabel
# ber-awalan `NEXT_PUBLIC_`: kunci seperti itu mem-BYPASS RLS, dan variabel
# NEXT_PUBLIC_* ikut ter-bundle ke browser.

# ── AI (Gemini) — paket 63 ───────────────────────────────────────────────────
# RAHASIA SERVER. Tidak pernah di-`NEXT_PUBLIC_`, tidak di-commit. Semua panggilan
# AI keluar dari route handler (server) lewat `lib/ai/provider.ts`.
GEMINI_API_KEY=
# Opsional — default `gemini-2.5-flash` untuk teks & vision.
GEMINI_MODEL_TEXT=
GEMINI_MODEL_VISION=

# ── Pembayaran (Midtrans) — paket 63 (RAIL; belum aktif) ─────────────────────
# Kosong = pembayaran belum aktif: rute `/api/payment/*` menjawab 503 apa adanya
# (JANGAN diisi sampai kredensialnya benar-benar ada).
MIDTRANS_SERVER_KEY=

# ── Migrasi & bukti RLS (dipakai `scripts/supabase/*`) ───────────────────────
# Hanya untuk menjalankan migrasi dari mesin/CI: Personal Access Token Supabase
# (Account → Access Tokens). JANGAN di-commit — set sebagai environment variable.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
