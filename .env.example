# ── CONTOH ENV (SALIN JADI `.env.local`) ────────────────────────────────────
# File ini SENGAJA hanya berisi nama variabel + nilai contoh. `.env.local`
# gitignored, jadi kunci lokal tidak pernah ikut ter-commit.

# Web Push (VAPID) — digenerate lokal via Node crypto (P-256).
# Public key dibagikan ke client; private key HANYA di server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@catetind.example

# ── Supabase (paket 45) ──────────────────────────────────────────────────────
# Kunci "publishable"/anon boleh ada di klien: yang melindungi data adalah RLS
# di database (`user_id = auth.uid()`), bukan kerahasiaan kunci ini.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sb_publishable_...>

# DILARANG menaruh kunci rahasia peran server di sini, di repo, atau di variabel
# ber-awalan `NEXT_PUBLIC_`: kunci seperti itu mem-BYPASS RLS, dan variabel
# NEXT_PUBLIC_* ikut ter-bundle ke browser.
#
# Kunci peran server yang MEMANG dibutuhkan (nilainya hanya di `.env.local`) —
# dipakai tunggal oleh `app/api/payment/webhook/route.ts` untuk mengaktifkan
# langganan setelah tanda tangan Midtrans diverifikasi:
SUPABASE_SERVICE_ROLE_KEY=

# ── AKUN REVIEWER MIDTRANS — SUDAH DIHAPUS ─────────────────────────────────
# Jalur login khusus `reviewer@catetind.com` + kode tetap (`123456`) beserta
# env `REVIEWER_TEST_LOGIN_ENABLED`-nya DIHAPUS setelah merchant di-ACC
# Midtrans. Semua akun, termasuk mantan akun uji, masuk lewat OTP email biasa.
# Tidak ada env yang perlu diisi untuk ini.

# ── MASUK CEPAT PEMILIK (kode tetap, tanpa email) ──────────────────────────
# SATU akun boleh masuk dengan kode tetap tanpa email dikirim:
# `app/api/auth/owner/route.ts`. Nilainya SENGAJA tidak ditulis di kode (repo
# ini publik), jadi kosong = jalur ini MATI dan semua akun kembali ke OTP email.
# Server-only: JANGAN beri awalan NEXT_PUBLIC_ (nilainya akan ikut ke browser).
# Detail & risikonya: docs/OWNER-FAST-LOGIN.md
OWNER_TEST_EMAIL=
# Tepat 6 angka (mengikuti form OTP). Contoh: 123456
OWNER_TEST_OTP=
# Opsional: set `0`/`false`/`off` untuk mematikan jalur ini tanpa mengubah kode.
OWNER_TEST_LOGIN_ENABLED=1

# ── AI (DeepSeek) — paket 82: provider diganti dari Gemini ──────────────────
# RAHASIA SERVER. Tidak pernah di-`NEXT_PUBLIC_`, tidak di-commit. Semua panggilan
# AI keluar dari route handler (server) lewat `lib/ai/provider.ts`.
DEEPSEEK_API_KEY=
# Opsional — endpoint kompatibel OpenAI; default `https://api.deepseek.com`.
DEEPSEEK_BASE_URL=
# Opsional — default `deepseek-flash` untuk TEKS dan VISION (satu-satunya model
# yang menerima gambar). `deepseek-v4-pro` untuk teks saja.
DEEPSEEK_MODEL_TEXT=
DEEPSEEK_MODEL_VISION=

# ── Pembayaran (Midtrans) — Core API, PRODUCTION ────────────────────────────
# Kosong = pembayaran belum aktif: rute `/api/payment/*` menjawab 503 apa adanya.
# Ambil nilainya dari Dashboard Midtrans (mode Production, bukan Sandbox).
# Key Name contoh: `M130180776-DEFAULT-PAYMENT-CLIENT`.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# ID merchant — referensi/diagnostik, bukan rahasia.
MIDTRANS_MERCHANT_ID=
# `1`/`true`/`yes`/`on` = production (api.midtrans.com). Kosong/`0` = sandbox.
# WAJIB `1` di hosting produksi — kalau kosong, tagihan dikirim ke sandbox.
MIDTRANS_IS_PRODUCTION=
# Kanal mana yang DITAWARKAN ke user TIDAK diatur env: daftarnya satu di
# `lib/payments/methods.ts` → `VERIFIED_ACTIVE_METHOD_IDS` (hanya kanal yang
# lolos probe `201` di merchant produksi). UI & route membaca daftar yang sama.
#
# URL yang didaftarkan di Dashboard Midtrans (Settings → Configuration):
#   Payment Notification URL : https://catetind.com/api/payment/webhook
#   Finish Redirect URL      : https://catetind.com/checkout/selesai
#   Unfinish Redirect URL    : https://catetind.com/checkout/selesai?status=pending
#   Error Redirect URL       : https://catetind.com/checkout/selesai?status=error

# ── Migrasi, template email & bukti RLS (dipakai `scripts/supabase/*`) ──────
# Hanya untuk menjalankan migrasi / menerapkan template email dari mesin/CI:
# Personal Access Token Supabase (Account → Access Tokens).
# JANGAN di-commit — set sebagai environment variable.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
